{
  "formatVersion": 1,
  "profiles": [
    {
      "id": "z200muse",
      "name": "旗舰洗碗机 Z200Muse",
      "priority": 100,
      "match": {
        "all": [
          { "path": "/userdata/app/Z200Muse", "op": "EXECUTABLE" }
        ],
        "none": []
      },
      "license": {
        "pid": "VTrRZRWy",
        "networkInterface": "wlan0",
        "targetPath": "/userdata/devices.xml",
        "contentTemplate": "<sections>\n<section name=\"init\">\n<item name=\"uuid\">{{did}}</item>\n<item name=\"key\">{{license}}</item>\n<item name=\"pid\">{{pid}}</item>\n</section>\n</sections>",
        "read": {
          "pidPattern": "<item name=\"pid\">([^<]*)</item>",
          "didPattern": "<item name=\"uuid\">([^<]*)</item>",
          "licensePattern": "<item name=\"key\">([^<]*)</item>"
        }
      },
      "quickActions": [
        {
          "title": "调试操作",
          "actions": [
            { "id": "show_test", "label": "查看测试文件", "command": "ls -l /userdata/test.txt", "output": true },
            { "id": "touch_test", "label": "创建测试文件", "command": "touch /userdata/test.txt" },
            { "id": "rm_test", "label": "删除测试文件", "command": "rm -f /userdata/test.txt", "confirm": true, "danger": true },
            { "id": "run_script", "label": "运行测试脚本", "command": "sh /tmp/test.sh", "output": true, "confirm": true }
          ]
        },
        {
          "title": "授权维护",
          "actions": [
            {
              "id": "clear_license",
              "label": "清除授权码",
              "description": "删除设备上的授权文件并重启设备，重启后设备为未授权状态，可重新补发授权码。",
              "command": "rm -f /userdata/devices.xml",
              "confirm": true,
              "danger": true,
              "reboot": true
            }
          ]
        }
      ]
    },
