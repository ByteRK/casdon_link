{
  "formatVersion": 1,
  "profiles": [
    {
      "id": "z200muse",
      "name": "Z200Muse",
      "priority": 100,
      "match": {
        "all": [
          { "path": "/userdata/app/Z200Muse", "op": "EXECUTABLE" }
        ],
        "none": []
      },
      "license": {
        "pid": "VTrRZRWy",
        "networkInterface": "wlan0",
        "targetPath": "/userdata/devices.xml",
        "contentTemplate": "<sections>\n<section name=\"app_config\">\n<item name=\"DeviceId\">{{did}}</item>\n<item name=\"License\">{{license}}</item>\n<item name=\"ProductId\">{{pid}}</item>\n</section>\n</sections>",
        "read": {
          "pidPattern": "<item name=\"ProductId\">([^<]*)</item>",
          "didPattern": "<item name=\"DeviceId\">([^<]*)</item>",
          "licensePattern": "<item name=\"License\">([^<]*)</item>"
        }
      },
      "quickActions": [
        {
          "title": "调试操作",
          "actions": [
            { "id": "show_test", "label": "查看测试文件", "command": "ls -l /userdata/test.txt", "output": true },
            { "id": "touch_test", "label": "创建测试文件", "command": "touch /userdata/test.txt" },
            { "id": "rm_test", "label": "删除测试文件", "command": "rm -f /userdata/test.txt", "confirm": true, "danger": true },
            { "id": "run_script", "label": "运行测试脚本", "command": "sh /tmp/test.sh", "output": true, "confirm": true }
          ]
        }
      ]
    },
