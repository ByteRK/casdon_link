<?xml version="1.0" encoding="utf-8"?>
<!--
    MD3 输入框：surfaceContainerHighest 承载可交互层级，1dp outline 提供边界。
    圆角统一为 medium（12dp），不再使用 14dp 这类中间值。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/surface_container_highest" />
    <stroke
        android:width="1dp"
        android:color="@color/outline" />
    <corners android:radius="@dimen/corner_medium" />

</shape>
