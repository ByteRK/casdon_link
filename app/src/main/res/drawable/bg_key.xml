<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        终端控制键背景：与 bg_input 同色同描边，但圆角收到 10dp。
        按键只有 40dp 高，沿用输入框/常规按钮的 14dp 圆角时，上下圆角弧线几乎占满高度，
        底部看上去像被切平了一截。
    -->
    <solid android:color="@color/input_surface" />
    <stroke android:width="1dp" android:color="@color/input_stroke" />
    <corners android:radius="10dp" />
</shape>
