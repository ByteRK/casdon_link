<?xml version="1.0" encoding="utf-8"?><!--
   备份排除规则（API 31 起用 dataExtractionRules，API 30 及以下用本文件）。
   见 https://developer.android.com/guide/topics/data/autobackup

   以下内容属于现场敏感数据或本机缓存，不随云备份/设备迁移带出：
   - sharedpref/devices.xml：设备记录（含加密后的登录密码，密钥无法迁移）
   - file/license_records.json：授权记录（含加密后的完整授权码）
   - file/repair_packages：修复包解压缓存，可由官方包重新导入
-->
<full-backup-content>
    <exclude domain="sharedpref" path="devices.xml" />
    <exclude domain="file" path="license_records.json" />
    <exclude domain="file" path="repair_packages" />
</full-backup-content>
