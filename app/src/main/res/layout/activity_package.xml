<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/packageRoot"
    style="@style/Widget.CasdonLink.Screen.Column">

    <LinearLayout style="@style/Widget.CasdonLink.Toolbar">

        <Button
            android:id="@+id/packageBack"
            style="@style/Widget.CasdonLink.Button.Icon"
            android:text="‹" />

        <TextView
            android:id="@+id/packageTitle"
            style="@style/Text.CasdonLink.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="修复包" />

        <TextView
            android:id="@+id/packageProgress"
            style="@style/Text.CasdonLink.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/packageDescription"
        style="@style/Text.CasdonLink.Label"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_lg" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stepList"
        style="@style/Widget.CasdonLink.List"
        android:layout_marginTop="@dimen/space_lg" />

    <Button
        android:id="@+id/runPackage"
        style="@style/Widget.CasdonLink.Button.Primary"
        android:layout_marginTop="@dimen/space_md"
        android:text="执行修复" />

</LinearLayout>