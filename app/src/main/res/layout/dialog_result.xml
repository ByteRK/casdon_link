<?xml version="1.0" encoding="utf-8"?>
<!-- 执行结果弹窗：输出区可滚动/可选中，下方固定复制、分享、保存与可选的重试入口。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_2xl"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_2xl"
    android:paddingBottom="@dimen/space_xs">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dialogResultText"
            style="@style/Text.CasdonLink.Mono"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogResultCopy"
            style="@style/Widget.CasdonLink.Button.Small"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="复制" />

        <Button
            android:id="@+id/dialogResultShare"
            style="@style/Widget.CasdonLink.Button.Small"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="分享" />

        <Button
            android:id="@+id/dialogResultSave"
            style="@style/Widget.CasdonLink.Button.Small"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="保存" />
    </LinearLayout>

    <Button
        android:id="@+id/dialogResultRetry"
        style="@style/Widget.CasdonLink.Button.Secondary"
        android:layout_marginTop="@dimen/space_sm"
        android:text="重试连接"
        android:visibility="gone" />
</LinearLayout>
