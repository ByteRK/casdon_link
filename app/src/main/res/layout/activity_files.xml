<?xml version="1.0" encoding="utf-8"?>
<!-- 用 FrameLayout 承载列表内容与右下角浮空按钮，避免按钮挤占顶部标题栏空间。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout style="@style/Widget.CasdonLink.Screen.Column">

        <LinearLayout style="@style/Widget.CasdonLink.Toolbar">

            <Button
                android:id="@+id/filesBackButton"
                style="@style/Widget.CasdonLink.Button.Icon"
                android:contentDescription="返回上一级目录"
                android:text="‹" />

            <TextView
                android:id="@+id/filesPath"
                style="@style/Text.CasdonLink.SectionTitle"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="切换目录"
                android:ellipsize="start"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="/" />

            <Button
                android:id="@+id/filesRefresh"
                style="@style/Widget.CasdonLink.Button.Icon"
                android:contentDescription="刷新当前目录"
                android:text="↻" />
        </LinearLayout>

        <TextView
            android:id="@+id/filesHint"
            style="@style/Text.CasdonLink.Caption"
            android:layout_marginTop="10dp"
            android:text="长按文件可操作" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fileList"
            style="@style/Widget.CasdonLink.List"
            android:layout_marginTop="10dp"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <!-- 三横线浮空按钮：新建/上传/返回等操作统一收纳在这里，不再占用顶部空间。 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/filesFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_xl"
        android:contentDescription="更多操作"
        android:src="@drawable/ic_menu_lines"
        app:backgroundTint="@color/primary"
        app:tint="@color/background" />
</FrameLayout>
