<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button android:id="@+id/filesBackButton" android:layout_width="52dp" android:layout_height="48dp" android:text="‹" android:textSize="24sp" />
        <TextView android:id="@+id/filesPath" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="start" android:singleLine="true" android:text="/" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@+id/uploadButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="上传" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/filesHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="长按文件可操作" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <ListView android:id="@+id/fileList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" android:divider="#22334455" android:dividerHeight="1dp" />
</LinearLayout>
