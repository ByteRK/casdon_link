<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminalRoot"
    style="@style/Widget.CasdonLink.Screen.Column">

    <LinearLayout style="@style/Widget.CasdonLink.Toolbar">

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.CasdonLink.Button.Icon"
            android:text="‹" />

        <TextView
            android:id="@+id/terminalTitle"
            style="@style/Text.CasdonLink.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="终端" />

        <TextView
            android:id="@+id/connectionState"
            style="@style/Text.CasdonLink.Caption"
            android:text="已连接" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/terminalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:fillViewport="true"
        android:padding="@dimen/row_padding">

        <TextView
            android:id="@+id/terminalOutput"
            style="@style/Text.CasdonLink.Mono"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>

    <!--
        终端控制键：软键盘上的控制字符和部分符号不好输入（中文输入法尤其），
        单独放一排按键直接发送或插入，可横向滑动以容纳更多按键。
    -->
    <HorizontalScrollView
        android:id="@+id/controlKeyScroll"
        style="@style/Widget.CasdonLink.KeyRow.Scroll">

        <LinearLayout style="@style/Widget.CasdonLink.KeyRow">

            <Button
                android:id="@+id/keyEsc"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="Esc" />

            <Button
                android:id="@+id/keyTab"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="Tab" />

            <Button
                android:id="@+id/keyCtrlC"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="Ctrl+C" />

            <Button
                android:id="@+id/keyCtrlD"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="Ctrl+D" />

            <Button
                android:id="@+id/keyCtrlZ"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="Ctrl+Z" />

            <Button
                android:id="@+id/keyCtrlL"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="Ctrl+L" />

            <Button
                android:id="@+id/keyHistoryPrev"
                style="@style/Widget.CasdonLink.Button.Key"
                android:contentDescription="上一条命令"
                android:text="↑" />

            <Button
                android:id="@+id/keyHistoryNext"
                style="@style/Widget.CasdonLink.Button.Key"
                android:contentDescription="下一条命令"
                android:text="↓" />

            <!-- 符号键插入输入框，不立即发送。 -->
            <Button
                android:id="@+id/keyPipe"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="|" />

            <Button
                android:id="@+id/keySlash"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="/" />

            <Button
                android:id="@+id/keyDash"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="-" />

            <Button
                android:id="@+id/keyTilde"
                style="@style/Widget.CasdonLink.Button.Key"
                android:text="~" />

            <!-- 本地缓冲操作：清屏只清手机侧显示，复制全部导出当前终端输出。 -->
            <Button
                android:id="@+id/keyClear"
                style="@style/Widget.CasdonLink.Button.Key"
                android:contentDescription="清空本地终端显示"
                android:text="清屏" />

            <Button
                android:id="@+id/keyCopyAll"
                style="@style/Widget.CasdonLink.Button.Key"
                android:contentDescription="复制全部终端输出"
                android:text="复制全部" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
            键盘默认放开：不锁输入类型，用户可以按需切中文输入法。
            远程调试若只能用 adb 注入文本，拼音输入法可能把字母吞进组合，
            此时可临时把本控件改成下面两行（明文密码键盘：各输入法都会直接上英文键盘，
            文本仍可见）：
                android:imeOptions="actionSend|flagNoExtractUi|flagNoPersonalizedLearning|flagForceAscii"
                android:inputType="textVisiblePassword"
            调完务必改回下面这两行，不要提交。
        -->
        <EditText
            android:id="@+id/commandInput"
            style="@style/Widget.CasdonLink.EditText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:hint="输入命令"
            android:imeOptions="actionSend|flagNoExtractUi|flagNoPersonalizedLearning"
            android:inputType="textNoSuggestions" />

        <Button
            android:id="@+id/sendCommandButton"
            style="@style/Widget.CasdonLink.Button.Inline"
            android:layout_marginStart="@dimen/space_md"
            android:text="发送" />
    </LinearLayout>

</LinearLayout>
