<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷操作条目：标题 + 可选说明；点击后执行规则里的命令队列。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/row_padding">

    <TextView
        android:id="@+id/actionLabel"
        style="@style/Text.CasdonLink.ListItemTitle"
        tools:text="查看应用日志" />

    <TextView
        android:id="@+id/actionDescription"
        style="@style/Text.CasdonLink.ListItemMeta"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone"
        tools:text="执行规则中的命令队列" />

</LinearLayout>
