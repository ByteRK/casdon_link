<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deviceRoot"
    style="@style/Widget.CasdonLink.Screen.Scroll"
    tools:context=".DeviceActivity">

    <LinearLayout style="@style/Widget.CasdonLink.Screen.ScrollContent">

        <!-- 标题行：IP 占剩余宽度，右侧显示命中的机型规则；未知机型也在这里显示。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deviceTitle"
                style="@style/Text.CasdonLink.ScreenTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                tools:text="172.16.241.28" />

            <TextView
                android:id="@+id/profileBadge"
                style="@style/Widget.CasdonLink.Badge"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="机型规则"
                android:visibility="gone"
                tools:text="Z200Muse" />
        </LinearLayout>

        <TextView
            android:id="@+id/deviceState"
            style="@style/Text.CasdonLink.Status"
            android:layout_marginTop="6dp"
            android:text="已连接" />

        <!-- 授权摘要：命中机型且能读取授权文件时显示，例如「设备授权 · 已授权 · b893…44d1」。 -->
        <TextView
            android:id="@+id/deviceLicense"
            style="@style/Text.CasdonLink.Caption"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone"
            tools:text="设备授权 · 已授权 · b893…44d1" />

        <!-- 断线卡片：连接丢失后停留本页，允许重试或返回；不直接退回首页。 -->
        <LinearLayout
            android:id="@+id/deviceLostCard"
            style="@style/Widget.CasdonLink.Card"
            android:layout_marginTop="@dimen/space_xl"
            android:visibility="gone">

            <TextView
                style="@style/Text.CasdonLink.SectionTitle"
                android:text="连接已断开" />

            <TextView
                style="@style/Text.CasdonLink.MultilineCaption"
                android:layout_marginTop="@dimen/space_sm"
                android:text="设备可能已重启或网络中断。" />

            <Button
                android:id="@+id/retryConnectionButton"
                style="@style/Widget.CasdonLink.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:text="重试连接" />

            <Button
                android:id="@+id/returnHomeButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_sm"
                android:text="返回首页" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Widget.CasdonLink.Card"
            android:layout_marginTop="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.CasdonLink.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="设备状态" />

                <Button
                    android:id="@+id/statusDetailButton"
                    style="@style/Widget.CasdonLink.Button.Text"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="详情" />

                <Button
                    android:id="@+id/refreshStatusButton"
                    style="@style/Widget.CasdonLink.Button.Icon.Small"
                    android:contentDescription="刷新状态"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/button_tonal_text" />
            </LinearLayout>

            <!-- 三条使用率环：内存 / 系统盘 / 数据盘；缺项在代码里隐藏。 -->
            <LinearLayout
                android:id="@+id/statusGauges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.example.casdonlink.ui.StatusGaugeView
                    android:id="@+id/memoryGauge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.example.casdonlink.ui.StatusGaugeView
                    android:id="@+id/rootStorageGauge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.example.casdonlink.ui.StatusGaugeView
                    android:id="@+id/dataStorageGauge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 运行时间 / CPU 负载：两个等宽状态块，只保留一眼能读懂的数值。 -->
            <LinearLayout
                android:id="@+id/statusFacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/uptimeFact"
                    style="@style/Widget.CasdonLink.StatusFact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.CasdonLink.StatusFactIcon"
                        android:src="@drawable/ic_status_uptime" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.CasdonLink.Label"
                            android:text="运行时间" />

                        <TextView
                            android:id="@+id/uptimeValue"
                            style="@style/Text.CasdonLink.Body"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loadFact"
                    style="@style/Widget.CasdonLink.StatusFact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.CasdonLink.StatusFactIcon"
                        android:src="@drawable/ic_status_load" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.CasdonLink.Label"
                            android:text="CPU 负载" />

                        <TextView
                            android:id="@+id/loadValue"
                            style="@style/Text.CasdonLink.Body"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/deviceUpdated"
                style="@style/Text.CasdonLink.Caption"
                android:layout_marginTop="@dimen/space_md"
                android:text="尚未刷新" />
        </LinearLayout>

        <!-- 机型操作：只在该设备命中规则时出现；补发授权码不受完整功能开关限制。 -->
        <LinearLayout
            android:id="@+id/profileActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.CasdonLink.SectionTitle"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="机型操作" />

            <Button
                android:id="@+id/licenseButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_md"
                android:text="授权码" />

            <Button
                android:id="@+id/quickActionsButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_md"
                android:text="快捷操作"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/deviceActionsTitle"
            style="@style/Text.CasdonLink.SectionTitle"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="设备操作" />

        <!-- 受限操作容器：默认隐藏，仅在开启完整功能后显示；
             后续新增的受限功能都放进这里，避免默认暴露给普通售后操作。 -->
        <LinearLayout
            android:id="@+id/advancedActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/terminalButton"
                style="@style/Widget.CasdonLink.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:text="交互终端" />

            <Button
                android:id="@+id/filesButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_md"
                android:text="文件管理" />
        </LinearLayout>

        <!-- 设备修复与重启是默认开放的操作，不随完整功能开关隐藏。 -->
        <Button
            android:id="@+id/importPackageButton"
            style="@style/Widget.CasdonLink.Button.Secondary"
            android:layout_marginTop="@dimen/space_md"
            android:text="设备修复" />

        <Button
            android:id="@+id/rebootDeviceButton"
            style="@style/Widget.CasdonLink.Button.Secondary"
            android:layout_marginTop="@dimen/space_md"
            android:text="重启设备" />

        <Button
            android:id="@+id/disconnectButton"
            style="@style/Widget.CasdonLink.Button.Danger"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="断开连接" />

    </LinearLayout>
</ScrollView>
