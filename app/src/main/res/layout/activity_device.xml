<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deviceRoot"
    style="@style/Widget.CasdonLink.Screen.Scroll"
    tools:context=".DeviceActivity">

    <LinearLayout style="@style/Widget.CasdonLink.Screen.ScrollContent">

        <TextView
            style="@style/Text.CasdonLink.Eyebrow"
            android:text="已连接设备" />

        <!-- 标题行：IP 占剩余宽度，右侧显示命中的机型规则；未知机型也在这里显示。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deviceTitle"
                style="@style/Text.CasdonLink.ScreenTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                tools:text="172.16.241.28" />

            <TextView
                android:id="@+id/profileBadge"
                style="@style/Widget.CasdonLink.Badge"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="机型规则"
                android:visibility="gone"
                tools:text="Z200Muse" />
        </LinearLayout>

        <TextView
            android:id="@+id/deviceState"
            style="@style/Text.CasdonLink.Status"
            android:layout_marginTop="6dp"
            android:text="连接正常" />

        <LinearLayout
            style="@style/Widget.CasdonLink.Card"
            android:layout_marginTop="@dimen/space_xl">

            <TextView
                style="@style/Text.CasdonLink.Label"
                android:text="设备状态" />

            <TextView
                android:id="@+id/deviceStatus"
                style="@style/Text.CasdonLink.MultilineBody"
                android:layout_marginTop="10dp"
                tools:text="Linux 6.1.118 armv7l\n运行时间 · 2 天 4 小时\n总内存 128 MB · 可用内存 42 MB" />

            <Button
                android:id="@+id/refreshStatusButton"
                style="@style/Widget.CasdonLink.Button.Small"
                android:layout_marginTop="14dp"
                android:text="刷新状态" />
        </LinearLayout>

        <!-- 机型操作：只在该设备命中规则时出现；补发授权码不受完整功能开关限制。 -->
        <LinearLayout
            android:id="@+id/profileActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.CasdonLink.SectionTitle"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="机型操作" />

            <Button
                android:id="@+id/licenseButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_md"
                android:text="补发授权码" />

            <Button
                android:id="@+id/quickActionsButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_md"
                android:text="快捷操作"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/Text.CasdonLink.SectionTitle"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="设备操作" />

        <!-- 受限操作容器：默认隐藏，仅在开启完整功能后显示；
             后续新增的受限功能都放进这里，避免默认暴露给普通售后操作。 -->
        <LinearLayout
            android:id="@+id/advancedActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/terminalButton"
                style="@style/Widget.CasdonLink.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:text="交互终端" />

            <Button
                android:id="@+id/filesButton"
                style="@style/Widget.CasdonLink.Button.Secondary"
                android:layout_marginTop="@dimen/space_md"
                android:text="文件管理" />
        </LinearLayout>

        <!-- 修复包是默认唯一开放的功能，不随完整功能开关隐藏。 -->
        <Button
            android:id="@+id/importPackageButton"
            style="@style/Widget.CasdonLink.Button.Secondary"
            android:layout_marginTop="@dimen/space_md"
            android:text="修复包" />

        <Button
            android:id="@+id/disconnectButton"
            style="@style/Widget.CasdonLink.Button.Danger"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="断开连接" />

    </LinearLayout>
</ScrollView>
