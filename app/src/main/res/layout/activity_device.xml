<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deviceRoot"
    style="@style/Widget.CasdonLink.Screen.Scroll"
    tools:context=".DeviceActivity">

    <LinearLayout style="@style/Widget.CasdonLink.Screen.ScrollContent">

        <TextView
            style="@style/Text.CasdonLink.Eyebrow"
            android:text="已连接设备" />

        <TextView
            android:id="@+id/deviceTitle"
            style="@style/Text.CasdonLink.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_sm"
            tools:text="172.16.241.28" />

        <TextView
            android:id="@+id/deviceState"
            style="@style/Text.CasdonLink.Status"
            android:layout_marginTop="6dp"
            android:text="连接正常" />

        <LinearLayout
            style="@style/Widget.CasdonLink.Card"
            android:layout_marginTop="@dimen/space_xl">

            <TextView
                style="@style/Text.CasdonLink.Label"
                android:text="设备状态" />

            <TextView
                android:id="@+id/deviceStatus"
                style="@style/Text.CasdonLink.MultilineBody"
                android:layout_marginTop="10dp"
                tools:text="Linux 6.1.118 armv7l\n运行时间 · 2 天 4 小时\n总内存 128 MB · 可用内存 42 MB" />

            <Button
                android:id="@+id/refreshStatusButton"
                style="@style/Widget.CasdonLink.Button.Small"
                android:layout_marginTop="14dp"
                android:text="刷新状态" />
        </LinearLayout>

        <TextView
            style="@style/Text.CasdonLink.SectionTitle"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="设备操作" />

        <Button
            android:id="@+id/terminalButton"
            style="@style/Widget.CasdonLink.Button.Primary"
            android:layout_marginTop="@dimen/space_md"
            android:text="交互终端" />

        <Button
            android:id="@+id/filesButton"
            style="@style/Widget.CasdonLink.Button.Secondary"
            android:layout_marginTop="@dimen/space_md"
            android:text="文件管理" />

        <Button
            android:id="@+id/importPackageButton"
            style="@style/Widget.CasdonLink.Button.Secondary"
            android:layout_marginTop="@dimen/space_md"
            android:text="修复包" />

        <Button
            android:id="@+id/disconnectButton"
            style="@style/Widget.CasdonLink.Button.Danger"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="断开连接" />

    </LinearLayout>
</ScrollView>

