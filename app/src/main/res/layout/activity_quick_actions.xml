<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quickRoot"
    style="@style/Widget.CasdonLink.Screen.Column"
    tools:context=".QuickActionsActivity">

    <LinearLayout style="@style/Widget.CasdonLink.Toolbar">

        <Button
            android:id="@+id/quickBack"
            style="@style/Widget.CasdonLink.Button.Icon.Back"
            android:contentDescription="返回设备页" />

        <TextView
            android:id="@+id/quickTitle"
            style="@style/Text.CasdonLink.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="快捷操作" />

        <TextView
            android:id="@+id/quickToolbarStatus"
            style="@style/Text.CasdonLink.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/quickSubtitle"
        style="@style/Text.CasdonLink.Label"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_lg" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quickActionList"
        style="@style/Widget.CasdonLink.List"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quickStatus"
            style="@style/Text.CasdonLink.Caption"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/quickStop"
            style="@style/Widget.CasdonLink.Button.Small"
            android:layout_width="wrap_content"
            android:text="停止"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
