<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/licenseRoot"
    style="@style/Widget.CasdonLink.Screen.Column"
    tools:context=".LicenseActivity">

    <LinearLayout style="@style/Widget.CasdonLink.Toolbar">

        <Button
            android:id="@+id/licenseBack"
            style="@style/Widget.CasdonLink.Button.Icon.Back"
            android:contentDescription="返回设备页" />

        <TextView
            android:id="@+id/licenseTitle"
            style="@style/Text.CasdonLink.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="授权码" />

        <TextView
            android:id="@+id/licenseToolbarStatus"
            style="@style/Text.CasdonLink.Caption" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_padding_bottom">

            <TextView
                android:id="@+id/licenseDevice"
                style="@style/Text.CasdonLink.MultilineBody"
                android:layout_marginTop="@dimen/space_lg"
                tools:text="机型 · Z200Muse\nPID · VTrRZRWy" />

            <LinearLayout
                style="@style/Widget.CasdonLink.Card"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.CasdonLink.Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="当前授权" />

                    <Button
                        android:id="@+id/licenseReload"
                        style="@style/Widget.CasdonLink.Button.InlineSmall"
                        android:text="重新读取" />
                </LinearLayout>

                <TextView
                    android:id="@+id/licenseReadAt"
                    style="@style/Text.CasdonLink.Caption"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="尚未读取" />

                <TextView
                    android:id="@+id/licenseCurrent"
                    style="@style/Text.CasdonLink.MultilineBody"
                    android:layout_marginTop="10dp"
                    tools:text="未授权（设备上不存在授权文件）" />

                <LinearLayout
                    android:id="@+id/licenseActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/licenseReveal"
                        style="@style/Widget.CasdonLink.Button.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="显示授权码" />

                    <Button
                        android:id="@+id/licenseClear"
                        style="@style/Widget.CasdonLink.Button.Small.Danger"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="清除授权码" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CasdonLink.Card"
                android:layout_marginTop="@dimen/space_lg">

                <!-- 阶段进度：一条横线 + 7 个状态圆点，圆点下方两字注释。 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginStart="@dimen/space_2xl"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="@dimen/space_2xl"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:id="@+id/licenseSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepApplyDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepApply"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="申请" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepWriteDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepWrite"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="写入" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepVerifyDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepVerify"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="校验" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepSyncDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepSync"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="同步" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepRebootDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepReboot"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="重启" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepOnlineDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepOnline"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="上线" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.CasdonLink.StepItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/licenseStepReadDot"
                                style="@style/Widget.CasdonLink.StepDot.Progress"
                                android:background="@drawable/dot_step_pending" />

                            <TextView
                                android:id="@+id/licenseStepRead"
                                style="@style/Text.CasdonLink.StepLabel"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="读取" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <CheckBox
                    android:id="@+id/licenseConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="已核对铭牌与 PID"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    style="@style/Text.CasdonLink.Caption"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="将覆盖现有授权并重启设备，请核对 PID。" />

                <Button
                    android:id="@+id/licenseStart"
                    style="@style/Widget.CasdonLink.Button.Primary"
                    android:layout_marginTop="@dimen/space_md"
                    android:enabled="false"
                    android:text="开始补发" />

                <ProgressBar
                    android:id="@+id/licenseProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/licenseStatus"
                    style="@style/Text.CasdonLink.Caption"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="读取设备信息…" />

                <TextView
                    android:id="@+id/licenseResult"
                    style="@style/Text.CasdonLink.MultilineBody"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/licenseCancelWait"
                    style="@style/Widget.CasdonLink.Button.Secondary"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="取消等待"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/licenseDone"
                    style="@style/Widget.CasdonLink.Button.Primary"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="返回设备页"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/licenseSuccessActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/licenseAgain"
                        style="@style/Widget.CasdonLink.Button.Secondary"
                        android:layout_width="match_parent"
                        android:text="再次补发" />
                </LinearLayout>
            </LinearLayout>

            <!-- 授权服务状态：进页面自动检测，按钮可手动重试。 -->
            <LinearLayout
                style="@style/Widget.CasdonLink.Card"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.CasdonLink.Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="授权服务" />

                    <Button
                        android:id="@+id/licenseCheckService"
                        style="@style/Widget.CasdonLink.Button.InlineSmall"
                        android:text="重新检测" />
                </LinearLayout>

                <TextView
                    android:id="@+id/licenseServiceStatus"
                    style="@style/Text.CasdonLink.MultilineCaption"
                    android:layout_marginTop="10dp"
                    android:text="尚未检测" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
