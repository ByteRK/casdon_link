<?xml version="1.0" encoding="utf-8"?>
<!-- 根节点用 NestedScrollView，使内嵌的最近设备列表能与页面滚动正确交接。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/Widget.CasdonLink.Screen.Scroll"
    tools:context=".MainActivity">

    <LinearLayout style="@style/Widget.CasdonLink.Screen.ScrollContent">

        <!-- 左上角标题区承接完整功能六连击手势；齿轮放在标题区外侧，避免点击被手势吞掉。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/mainTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.CasdonLink.Eyebrow"
                    android:text="CASDON LINK" />

                <TextView
                    style="@style/Text.CasdonLink.HeroTitle"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="设备连接" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                style="@style/Widget.CasdonLink.Button.IconImage"
                android:layout_marginStart="@dimen/space_md"
                android:contentDescription="设置"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.CasdonLink.Card"
            android:layout_marginTop="@dimen/space_3xl">

            <TextView
                style="@style/Text.CasdonLink.Label"
                android:text="目标地址" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ipInput"
                    style="@style/Widget.CasdonLink.EditText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="192.168.1.100"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/portInput"
                    style="@style/Widget.CasdonLink.EditText.Port"
                    android:layout_marginStart="@dimen/space_md"
                    android:hint="23"
                    android:text="23" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/usernameInput"
                    style="@style/Widget.CasdonLink.EditText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="用户名"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/Widget.CasdonLink.EditText"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="密码"
                    android:inputType="textPassword" />
            </LinearLayout>

            <Button
                android:id="@+id/connectButton"
                style="@style/Widget.CasdonLink.Button.Primary"
                android:layout_marginTop="14dp"
                android:text="连接设备" />

            <Button
                android:id="@+id/diagnoseButton"
                style="@style/Widget.CasdonLink.Button.Small"
                android:layout_marginTop="@dimen/space_md"
                android:text="网络诊断" />
        </LinearLayout>

        <TextView
            android:id="@+id/recentTitle"
            style="@style/Text.CasdonLink.SectionTitle"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="最近设备" />

        <!-- 高度由代码按行数计算：条目少于可视行数时自适应，超过后固定高度并在列表内滚动。 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical" />

        <!-- 版本与版权声明：文本在 MainActivity 中按 BuildConfig 组装，样式由 Text.CasdonLink.Footer 维护。 -->
        <TextView
            android:id="@+id/aboutInfo"
            style="@style/Text.CasdonLink.Footer"
            android:layout_marginTop="@dimen/space_3xl" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
