<?xml version="1.0" encoding="utf-8"?>
<!--
    组件样式表：同类组件只在布局里写 style，不再重复写字号、颜色、内边距、背景。
    新增页面时优先复用这里的样式；确需差异时用 `style + 少量覆盖属性`，
    或在本文件里扩展子样式，避免在布局中散落魔法值。
    命名约定：Text.* 只描述文字，Widget.* 描述完整控件（含尺寸/背景）。

    Material Design 3 约束：
    - 文字使用 MD3 type scale（Headline / Title / Body / Label），颜色取 MD3 color role。
    - 圆角只用 medium（12dp）或 large（16dp），禁止 full（胶囊）与不规则形状。
    - 层级用 surfaceContainer 明度差表达，卡片/按钮/弹窗均不依赖阴影。
-->
<resources>

    <!-- ==================== 文字样式 ==================== -->

    <!-- 前缀父级：显式存在，避免点号命名触发隐式继承查找。 -->
    <style name="Text.CasdonLink" parent="" />

    <!-- 页面顶部小标题（全大写、宽字距） -->
    <style name="Text.CasdonLink.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- 首页主标题 -->
    <style name="Text.CasdonLink.HeroTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_hero</item>
    </style>

    <!-- 页面主标题（设备页等） -->
    <style name="Text.CasdonLink.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
    </style>

    <!--
        二级页面标题栏中的标题。
        ellipsize=marquee：标题超长时横向滚动显示完整内容；文本未超出宽度时 TextView
        不会滚动，因此短标题保持静止。跑马灯需要单行且有宽度约束（布局里都是 0dp+weight），
        并由代码设 isSelected = true 启动（android:selected 无法在 style 中声明）。
    -->
    <style name="Text.CasdonLink.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_toolbar_title</item>
    </style>

    <!-- 区块标题（设备操作 / 最近设备） -->
    <style name="Text.CasdonLink.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_section_title</item>
    </style>

    <!-- 页面副标题 / 说明 -->
    <style name="Text.CasdonLink.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- 注释 / 提示文字 -->
    <style name="Text.CasdonLink.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- 多行注释 / 进度说明 -->
    <style name="Text.CasdonLink.MultilineCaption" parent="Text.CasdonLink.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:lineSpacingExtra">@dimen/space_xs</item>
    </style>

    <!-- 表单字段标签 -->
    <style name="Text.CasdonLink.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!-- 正文 -->
    <style name="Text.CasdonLink.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- 多行正文（设备状态等） -->
    <style name="Text.CasdonLink.MultilineBody" parent="Text.CasdonLink.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:lineSpacingExtra">@dimen/space_xs</item>
    </style>

    <!-- 机型徽标文字：单行省略，完整名称在机型详情里查看。 -->
    <style name="Text.CasdonLink.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- 连接状态等强调文字 -->
    <style name="Text.CasdonLink.Status" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- 等宽字体（终端输出、命令输入） -->
    <style name="Text.CasdonLink.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_mono</item>
    </style>

    <!-- 列表项标题 -->
    <style name="Text.CasdonLink.ListItemTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_body_large</item>
    </style>

    <!--
        列表项标题（强调、单行）。超长时跑马灯滚动（由代码设 isSelected = true 启动），
        文本未超出宽度时不会滚动；需要跑马灯的行必须在横向布局里有宽度约束。
    -->
    <style name="Text.CasdonLink.ListItemStrongTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_section_title</item>
    </style>

    <!-- 列表项次要信息 -->
    <style name="Text.CasdonLink.ListItemMeta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- 列表项次要信息（失败原因，用危险色强调） -->
    <style name="Text.CasdonLink.ListItemMeta.Danger" parent="Text.CasdonLink.ListItemMeta">
        <item name="android:textColor">@color/error</item>
    </style>

    <!-- 列表行前导符号（文件/目录图标位） -->
    <!-- 对话框标题 -->
    <style name="Text.CasdonLink.DialogTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_toolbar_title</item>
    </style>

    <!-- 设备状态环形指标中的百分比 -->
    <style name="Text.CasdonLink.GaugeValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 授权阶段进度文字：两字注释，颜色由代码按状态切换。 -->
    <style name="Text.CasdonLink.StepLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 页面底部声明（版本/编译时间/版权），居中弱化显示；视觉权重与参考项目设置页页脚一致。 -->
    <style name="Text.CasdonLink.Footer" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">@dimen/space_xs</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- 悬浮菜单项文字 -->
    <style name="TextAppearance.CasdonLink.PopupMenu" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_body_large</item>
    </style>


    <!-- ==================== 容器样式 ==================== -->

    <style name="Widget.CasdonLink" parent="" />

    <!-- 可滚动页面根节点（首页、设备页） -->
    <style name="Widget.CasdonLink.Screen" parent="" />

    <style name="Widget.CasdonLink.Screen.Scroll" parent="Widget.CasdonLink.Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/surface</item>
        <item name="android:fillViewport">true</item>
    </style>

    <!-- 可滚动页面的内容列 -->
    <style name="Widget.CasdonLink.Screen.ScrollContent" parent="Widget.CasdonLink.Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/screen_padding_vertical</item>
        <item name="android:paddingEnd">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/screen_padding_bottom</item>
    </style>

    <!-- 非滚动页面根列（文件页、修复包页、终端页） -->
    <style name="Widget.CasdonLink.Screen.Column" parent="Widget.CasdonLink.Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/screen_padding_vertical</item>
        <item name="android:paddingEnd">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/screen_padding_bottom</item>
    </style>

    <!-- 卡片容器：surfaceContainerLow + 16dp，无描边、无阴影。 -->
    <style name="Widget.CasdonLink.Card" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>

    <!-- 设备状态信息块：在卡片内再抬一层 surfaceContainer，12dp 圆角。 -->
    <style name="Widget.CasdonLink.StatusFact" parent="Widget.CasdonLink">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_stat_tile</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <!-- 状态信息块左侧图标：20dp，纯装饰，不参与无障碍焦点。 -->
    <style name="Widget.CasdonLink.StatusFactIcon" parent="Widget.CasdonLink">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 二级页标题栏：返回按钮 + 标题 + 状态 -->
    <style name="Widget.CasdonLink.Toolbar" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- 占满剩余高度的列表（RecyclerView）；分隔线在代码里由 configureAsList() 挂装饰器。 -->
    <style name="Widget.CasdonLink.List" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">vertical</item>
    </style>

    <!-- 单行列表项（文件行）；按下反馈由可选项背景提供 -->
    <style name="Widget.CasdonLink.ListRow" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_row_height</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
    </style>

    <!-- 文件/目录前导图标：34dp 槽位内居中 24dp 矢量图标。 -->
    <style name="Widget.CasdonLink.FileIcon" parent="Widget.CasdonLink">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">5dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 多行列表项（修复步骤行） -->
    <style name="Widget.CasdonLink.ListRowBlock" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/row_padding</item>
    </style>

    <!-- 修复步骤状态圆点：颜色与尺寸集中在样式里，状态换色由代码切换背景。 -->
    <style name="Widget.CasdonLink.StepDot" parent="Widget.CasdonLink">
        <item name="android:layout_width">@dimen/step_dot_size</item>
        <item name="android:layout_height">@dimen/step_dot_size</item>
        <item name="android:layout_marginEnd">@dimen/space_md</item>
    </style>

    <!-- 授权阶段进度：每个阶段一列，圆点在上、文字在下。 -->
    <style name="Widget.CasdonLink.StepItem" parent="Widget.CasdonLink">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="Widget.CasdonLink.StepDot.Progress" parent="Widget.CasdonLink">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">12dp</item>
    </style>

    <!-- 修复步骤行右侧内容列（标题 + 仅在失败时出现的错误说明） -->
    <style name="Widget.CasdonLink.StepBody" parent="Widget.CasdonLink">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- 机型徽标：12dp 圆角（非胶囊），显示在设备 IP 右侧。 -->
    <style name="Widget.CasdonLink.Badge" parent="Text.CasdonLink.Badge">
        <item name="android:layout_height">@dimen/badge_height</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxWidth">@dimen/badge_max_width</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <!-- 最近设备记录条目：可点击卡片；高度固定为单行，列表才能按行数约束可视区域。 -->
    <style name="Widget.CasdonLink.RecentDeviceRow" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/recent_device_row_height</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
        <item name="android:background">@drawable/bg_card_interactive</item>
        <item name="android:clickable">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- 行内小按钮：在标签旁放「重新读取 / 重新检测」这类次要操作。 -->
    <style name="Widget.CasdonLink.Button.InlineSmall" parent="Widget.CasdonLink.Button.Small">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_sm</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>


    <!-- ==================== 按钮样式（MaterialButton） ==================== -->

    <style name="Widget.CasdonLink.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_2xl</item>
        <item name="android:paddingEnd">@dimen/space_2xl</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="elevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CasdonLink.Medium</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 主操作按钮（实心 primary） -->
    <style name="Widget.CasdonLink.Button.Primary" parent="Widget.CasdonLink.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <!-- 次操作按钮（MD3 outlined：透明底 + outline 描边 + primary 文字） -->
    <style name="Widget.CasdonLink.Button.Secondary" parent="Widget.CasdonLink.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="rippleColor">@color/ripple_primary</item>
        <item name="strokeColor">@color/button_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 小号次操作按钮（刷新、诊断） -->
    <style name="Widget.CasdonLink.Button.Small" parent="Widget.CasdonLink.Button.Secondary">
        <item name="android:layout_height">@dimen/control_height_small</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!-- 小号危险按钮（清除授权码等） -->
    <style name="Widget.CasdonLink.Button.Small.Danger" parent="Widget.CasdonLink.Button.Small">
        <item name="android:textColor">@color/button_danger_text</item>
        <item name="rippleColor">@color/ripple_error</item>
        <item name="strokeColor">@color/button_danger_stroke</item>
    </style>

    <!-- 危险操作按钮（断开连接、删除） -->
    <style name="Widget.CasdonLink.Button.Danger" parent="Widget.CasdonLink.Button.Secondary">
        <item name="android:textColor">@color/button_danger_text</item>
        <item name="rippleColor">@color/ripple_error</item>
        <item name="strokeColor">@color/button_danger_stroke</item>
    </style>

    <!-- 图标/符号按钮（返回箭头）：tonal 图标按钮，12dp 圆角。 -->
    <style name="Widget.CasdonLink.Button.Icon" parent="Widget.CasdonLink.Button">
        <item name="android:layout_width">@dimen/icon_button_width</item>
        <item name="android:layout_height">@dimen/icon_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/button_tonal_text</item>
        <item name="android:textSize">@dimen/text_icon</item>
        <item name="backgroundTint">@color/button_tonal_bg</item>
        <item name="rippleColor">@color/ripple_on_surface</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 图片图标按钮（首页右上角设置齿轮）：tonal + 12dp 圆角 + 水波纹。 -->
    <style name="Widget.CasdonLink.Button.IconImage" parent="Widget.CasdonLink">
        <item name="android:layout_width">@dimen/icon_button_width</item>
        <item name="android:layout_height">@dimen/icon_button_height</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- 紧凑图标按钮（设备状态卡右上角刷新）：40dp，图标 24dp，保持 12dp 圆角。 -->
    <style name="Widget.CasdonLink.Button.Icon.Small" parent="Widget.CasdonLink.Button.Icon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
    </style>

    <!-- 48dp 图标动作按钮的通用内边距：24dp 图标在 48dp 内居中。 -->
    <style name="Widget.CasdonLink.Button.Icon.Action" parent="Widget.CasdonLink.Button.Icon">
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/button_tonal_text</item>
    </style>

    <!-- 二级页面返回按钮：统一使用矢量箭头，避免字体符号在不同系统字体下偏移。 -->
    <style name="Widget.CasdonLink.Button.Icon.Back" parent="Widget.CasdonLink.Button.Icon.Action">
        <item name="icon">@drawable/ic_arrow_back</item>
    </style>

    <!-- 文件页刷新按钮：矢量刷新图标。 -->
    <style name="Widget.CasdonLink.Button.Icon.Refresh" parent="Widget.CasdonLink.Button.Icon.Action">
        <item name="icon">@drawable/ic_refresh</item>
    </style>

    <!-- 行内固定宽度主按钮（终端发送） -->
    <style name="Widget.CasdonLink.Button.Inline" parent="Widget.CasdonLink.Button.Primary">
        <item name="android:layout_width">@dimen/control_width_inline</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <!-- 弹窗文字按钮：保持 MD3 文字按钮观感，但形状改为 medium（12dp），不使用胶囊。 -->
    <style name="Widget.CasdonLink.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="shapeAppearance">@style/ShapeAppearance.CasdonLink.Medium</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <!-- 行内文字按钮（设备状态「详情」等），比常规按钮更紧凑。 -->
    <style name="Widget.CasdonLink.Button.Text" parent="Widget.CasdonLink.Button.Dialog">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!--
        终端控制键（Esc / Tab / Ctrl+C / 符号键）。
        focusable=false：点击时不能让输入框失焦，否则软键盘会收起，连续按键就断了。
        点击依然有效（clickable 不受 focusable 影响）。
        40dp 高的按键用 12dp medium 圆角，与全局圆角规范一致。
    -->
    <style name="Widget.CasdonLink.Button.Key" parent="Widget.CasdonLink.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/control_height_key</item>
        <item name="android:layout_marginEnd">@dimen/space_sm</item>
        <item name="android:focusable">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:minWidth">@dimen/control_width_key</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/button_tonal_text</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="backgroundTint">@color/button_tonal_bg</item>
        <item name="rippleColor">@color/ripple_on_surface</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 终端控制键行（可横向滑动） -->
    <style name="Widget.CasdonLink.KeyRow.Scroll" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
        <item name="android:scrollbars">none</item>
    </style>

    <!-- 控制键行的内层横向排列容器 -->
    <style name="Widget.CasdonLink.KeyRow" parent="Widget.CasdonLink">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>


    <!-- ==================== 悬浮菜单样式 ==================== -->

    <!-- 悬浮操作菜单（文件页浮空按钮） -->
    <style name="Widget.CasdonLink.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>


    <!-- ==================== 输入框样式 ==================== -->

    <style name="Widget.CasdonLink.EditText" parent="Widget.CasdonLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/text_field_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/field_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/field_padding_horizontal</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_body_large</item>
    </style>

    <!-- 端口输入框（居中、限数字） -->
    <style name="Widget.CasdonLink.EditText.Port" parent="Widget.CasdonLink.EditText">
        <item name="android:layout_width">@dimen/port_field_width</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">5</item>
    </style>

</resources>
